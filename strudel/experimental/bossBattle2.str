const setBpm = (bpm) => setcpm(bpm / 4);
setBpm(155);

const drums = (pat) => pat.midichan(10).midi();
const lead = (pat) => pat.midichan(1).midi();
const bass = (pat) => pat.midichan(2).midi();
const acid = (pat) => pat.midichan(3).midi();

const p_drums = drums(stack(
  note("<[36 36*2 36 36] [36 36 36*2 36]>"),
  note("<~ 38 ~ 38> <~ 38 ~ [38*3]>"),
  note("< [[42*4]*4]!8 [[~ 46]*4]!8 >"),
  note("<~!3 [50*2 47*2 43*2 43*2]>")
));

const p_lead = lead(
  note("< <[a4 ~ c5 d5] [e5 ~ g5 ~] [a5 g5 e5 d5] [c5 d5 e5 ~]>!8 <[c5 ~ e5 f5] [g5 ~ a5 ~] [c6 b5 g5 f5] [e5 f5 g5 ~]>!8 >")
    .fast(2)
);

const p_bass = bass(
  note("a2")
    .struct("<[x [~ x] x]*4>")
    .add(note("< <0 -2 -4 -5>!8 <-4 -2 0 3>!8 >"))
);

const p_acid = acid(
  note("< <[a3 c4 e4 a4] [g3 b3 d4 g4] [f3 a3 c4 f4] [e3 gs3 b3 e4]>!8 <[f3 a3 c4 f4] [e3 gs3 b3 e4] [d3 f3 a3 d4] [c3 e3 g3 c4]>!8 >")
    .fast(4)
);

stack(
  p_drums,
  p_lead,
  p_bass,
  p_acid
)
