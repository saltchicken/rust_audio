stack(
  // ---------------------------------------------------------
  // DRUM MACHINE (Rust Ch 9 = Strudel Ch 10)
  // 36: Kick, 38: Snare, 42: Hi-hat, 43/47/50: Toms
  // ---------------------------------------------------------
  stack(
    // Bar 1 & 3: Tresillo syncopation | Bar 2 & 4: 4-on-the-floor
    note("<36(3,8) 36!4 36(3,8) 36!4>"), 
    
    // Classic off-beat 8th note hats
    note("[~ 42]*4"),                    
    
    // Snare on 2 & 4, with a trap-style triplet roll on the 4th bar
    note("~ 38 ~ <38 38 38 [38*3]>"),    
    
    // Descending tom fill dropping in every 4th bar
    note("<~ ~ ~ [50 47 43*2]>")         
  ).midichan(10).midi(),


  // ---------------------------------------------------------
  // SYNTH LEAD (Rust Ch 0 = Strudel Ch 1)
  // Utilizing the 16-Voice Polyphony for Dub Techno Chords
  // ---------------------------------------------------------
  note("<[a4,c5,e5] [f4,a4,c5] [c4,e4,g4] [g4,b4,d5]>")
    // Syncopated rhythmic gates to let the delay/reverb tails breathe
    .struct("<x(3,8) x(3,8,2) x(5,8) [~ x*2 ~ x]>") 
    .midichan(1).midi(),


  // ---------------------------------------------------------
  // BASS LINE (Rust Ch 1 = Strudel Ch 2)
  // Fat Analog Saw + Sub. Rolling 16th-note bouncing bass
  // ---------------------------------------------------------
  note("<a1 f1 c1 g1>")
    // Adds a +12 semitone (1 octave) jump rhythmically over a 16th note grid
    .add(note("<[0 0 12 0]*4 [0 12 0 0]*4 [0 0 0 12]*4 [0 12 0 12]*4>"))
    .midichan(2).midi(),


  // ---------------------------------------------------------
  // ACID PLUCK (Rust Ch 2 = Strudel Ch 3)
  // Arpeggiating counter-melody utilizing the fast filter zap
  // ---------------------------------------------------------
  note("<[a2 c3 e3 a3] [f2 a2 c3 f3] [c2 e2 g2 c3] [g2 b2 d3 g3]>")
    .fast(4) // Runs the 4 notes above 4 times per bar (16th notes)
    // Euclidean gating to create a complex, evolving groove
    .struct("<x(11,16) x(9,16) x*16 [~ x]*8>") 
    .midichan(3).midi()

).cpm(128/4)
