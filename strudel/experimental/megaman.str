const setBpm = (bpm) => setcpm(bpm / 4);
setBpm(165);

const drums = (pat) => pat.midichan(10).midi();
const lead = (pat) => pat.midichan(1).midi();
const bass = (pat) => pat.midichan(2).midi();
const acid = (pat) => pat.midichan(3).midi();

const p_drums = drums(stack(
  note("<[36 36 ~ 36] [36 ~ 36 36]>*2"),
  note("[~ 38]*2"),
  note("42*8"),
  note("<~ ~ ~ [~ 50 47 43]>"),
  ccv(sine.range(0.25, 0.9).slow(8)).ccn(16)
));

const p_bass = bass(stack(
  "<c2 ab1 eb2 bb1>".struct("[x x x ~ x x ~ x]*2").note(),
  ccv(saw.range(0.3, 0.9).fast(4)).ccn(74),
  ccv(0.8).ccn(14),
  ccv(0.4).ccn(15)
));

const p_acid = acid(stack(
  note("<[c4 eb4 g4 eb4] [ab3 c4 eb4 c4] [eb4 g4 bb4 g4] [bb3 d4 f4 d4]>").fast(2),
  ccv(sine.range(0.2, 0.8).slow(4)).ccn(74)
));

const p_lead = lead(stack(
  "< <c5 eb5 g5> <f5 d5 bb4> <eb5 c5 g4> <d5 bb4 f4> >".struct("<[x ~ ~ x ~ x x ~] [x x ~ x ~ ~ x x]>*2").note(),
  ccv(0.1).ccn(20), 
  ccv(0.5).ccn(21), 
  ccv(0.6).ccn(86), 
  ccv(0.5).ccn(85), 
  ccv(sine.range(0.2, 0.8).fast(8)).ccn(91),
  ccv(0.7).ccn(90)
));

stack(
  p_drums,
  p_bass,
  p_acid,
  p_lead
)
