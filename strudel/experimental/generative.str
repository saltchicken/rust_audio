stack(
  // ---------------------------------------------------------
  // GENERATIVE DRUM MACHINE (Rust Ch 9 = Strudel Ch 10)
  // Sparse, drifting rhythm to feed into the heavy reverb
  // ---------------------------------------------------------
  stack(
    // Kick: Drifting, sparse 808-style pulses
    note("<[36 ~ ~ ~] [~ ~ 36 ~] [36 ~ ~ ~] [~ ~ ~ ~]>"),
    
    // Snare: Occasional distant rim knocks
    note("<[~ ~ ~ ~] [~ ~ 38 ~] [~ ~ ~ ~] [~ ~ ~ 38]>"), 
    
    // Hats: Bouncing off-beats that act like rain drops
    note("<[~ 42 ~ 42] [~ 42 42 ~] [42 ~ ~ 42] [42 42 42 ~]>"), 
    
    // Toms: Deep sparse low tom rolls
    note("<~ ~ ~ [~ ~ 43 43]>")
    
  ).midichan(10).midi(),

  // ---------------------------------------------------------
  // AMBIENT SWELLS (Rust Ch 0 = Strudel Ch 1)
  // Very slow, overlapping chords. The rests (~) allow the 
  // 4000ms envelope release to ring out endlessly.
  // ---------------------------------------------------------
  note("<[c4,g4,eb5] ~ [eb4,bb4,f5] ~ [f4,c5,g5] ~ [g4,d5,a5] ~>/2")
    .midichan(1).midi(),

  // ---------------------------------------------------------
  // SUB DRONE (Rust Ch 1 = Strudel Ch 2)
  // Slow moving root notes sitting underneath the swells
  // ---------------------------------------------------------
  note("<c2 ~ eb1 ~ f1 ~ g1 ~>/2")
    .midichan(2).midi(),

  // ---------------------------------------------------------
  // GENERATIVE PLUCKS (Rust Ch 2 = Strudel Ch 3)
  // Rapid, shifting arpeggios that bounce through the ping-pong delay
  // ---------------------------------------------------------
  note("c4")
    .struct("<[~ x]*4 [x*8] [~ x x ~] [[x ~ x ~] [~ x ~ x]]>/2")
    .add(note("<0 3 7 10>/4")) // Shifting intervals
    .add(note("<12 0 12 24>/2")) // Occasional octave jumps
    .midichan(3).midi()

// ---------------------------------------------------------
// TEMPO: Slowed down for an ambient, drifting feel
// ---------------------------------------------------------
).cpm(85/4)
