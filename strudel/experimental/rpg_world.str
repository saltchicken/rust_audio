const setBpm = (bpm) => setcpm(bpm / 4);
setBpm(128);

// Constants for scales to maintain harmonic consistency
const BASS_SCALE = 'G1:dorian';
const MOOG_SCALE = 'G2:dorian';
const LEAD_SCALE = 'G4:dorian';

// Instrument Helper Functions targeting Rust MIDI channels
const lead  = (pat) => pat.midichan(1).midi();
const bass  = (pat) => pat.midichan(2).midi();
const moog  = (pat) => pat.midichan(3).midi();
const drums = (pat) => pat.midichan(10).midi();

// Modular Pattern Composition

// 1. Drums: Driving 4/4 with evolving hi-hats and occasional tom fills
const k  = note("36*4").ccn(16).ccv(80);                     // CC 16: Kick Decay
const s  = note("<~ 38> <~ [38*2 38]>").ccn(17).ccv(64);     // CC 17: Snare Decay
const hh = note("[42*4]*4").ccn(18).ccv(sine.range(30, 90).fast(2)); // CC 18: Hi-hat Decay modulation
const t  = note("<~!7 [50 47 43 43]>").ccn(19).ccv(100);      // CC 19: Tom Decay (HT, MT, LT)

const p_drums = drums(stack(k, s, hh, t));

// 2. Bass Line: Bouncy, syncopated rhythm with filter sweep and sub-bass
const p_bass = bass(
  note("<[0 0 ~ 0] [0 ~ 0 0]>*2")
    .add(note("<0 0 3 -2>"))
    .scale(BASS_SCALE)
    .ccn(74).ccv(saw.range(30, 110).slow(4)) // CC 74: Filter Cutoff Hz sweep
    .ccn(14).ccv(127)                        // CC 14: Max Sub Mix for heavy low-end
    .ccn(15).ccv(45)                         // CC 15: Short, snappy Amp Decay
);

// 3. Moog Pluck: Evolving arpeggios through a squelchy resonant filter & delay
const arpA = "[0 2 4 6]";
const arpB = "[6 4 2 0]";
const arpC = "[1 3 5 7]";
const arpD = "[7 5 3 1]";

const p_moog = moog(
  note(cat(arpA, arpB, arpC, arpD))
    .fast(4)
    .scale(MOOG_SCALE)
    .ccn(74).ccv(sine.range(40, 120).slow(8)) // CC 74: Slow Filter Cutoff LFO
    .ccn(71).ccv(105)                         // CC 71: High Filter Resonance
    .ccn(85).ccv(80)                          // CC 85: Delay Feedback
    .ccn(86).ccv(50)                          // CC 86: Delay Mix
);

// 4. Synth Lead: Sparse, atmospheric melody soaking in reverb
const p_lead = lead(
  note("<[0 ~ ~ 4] [~ 6 ~ 3] [~ ~ 5 ~] [4 ~ 2 0]>")
    .scale(LEAD_SCALE)
    .slow(2)
    .ccn(20).ccv(100)  // CC 20: Slow Attack MS
    .ccn(21).ccv(110)  // CC 21: Long Release MS
    .ccn(88).ccv(90)   // CC 88: Reverb Mix
    .ccn(89).ccv(127)  // CC 89: Reverb Wet Scale
);

// Final Output Stack to the Custom Rust Engine
stack(
  p_drums,
  p_bass,
  p_moog,
  p_lead
)
