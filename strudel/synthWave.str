const setBpm = (bpm) => setcpm(bpm / 4);
setBpm(115);

const drums = (pat) => pat.midichan(10).midi();
const lead = (pat) => pat.midichan(1).midi();
const bass = (pat) => pat.midichan(2).midi();
const acid = (pat) => pat.midichan(3).midi();

const p_drums = drums(stack(
  note("<[36*4]!3 [36 36 36 ~]>"),
  note("<[~ 38 ~ 38]!3 [~ 38 38 [38 38]]>"),
  note("<[[~ 42]*4]!3 [42*8]>"),
  note("<~!3 [~ ~ [50 47] [43 43]]>")
));

const p_lead = lead(
  note("<~ [e4 g4 b4 d5] e4 [~ ~ [e4 g4 a4 b4] [d5 e5 g5 a5]]>/4")
);

const p_bass = bass(
  note("e2")
    .struct("<[~ x]*4 [x*16] x [[x ~ ~ x] [~ x ~ ~] [x ~ x ~] [~ ~ x ~]]>/4")
    .add(note("<0 -4 -2 -5>/2"))
);

const p_acid = acid(
  note("e4")
    .struct("<[~ x]*4 [x*16] x [[x ~ ~ x] [~ x ~ ~] [x ~ x ~] [~ ~ x ~]]>/4")
    .add(note("<0 -4 -2 -5>/2"))
);

stack(
  p_drums,
  p_lead,
  p_bass,
  p_acid
)
