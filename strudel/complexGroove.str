stack(
  // ==========================================
  // TRACK 1: DRUM MACHINE (Rust Ch 9 = Strudel Ch 10)
  // ==========================================
  stack(
    note("36")
  ).midichan(10).midi(),

  // ==========================================
  // TRACK 2: SYNTH LEAD (Rust Ch 0 = Strudel Ch 1)
  // ==========================================
  note("<[c4,eb4,g4,bb4,d5] [f4,ab4,c5,eb5] [d4,f4,ab4,c5] [g4,b4,d5,f5]>")
    .slow(2) 
    .arp("<up down updown pinkybo>") 
    .fast(4) 
    .sustain(0.2) 
    .off(1/16, n => n.add(12).velocity(0.6)) 
    .midichan(1).midi(),

  // ==========================================
  // TRACK 3: BASS LINE (Rust Ch 1 = Strudel Ch 2)
  // ==========================================
  note("<c2 ~ eb2 ~> <f2 d2 c2 ~>")
    .struct("x ~ x x ~ x x ~") 
    .off(1/8, n => n.add(12).velocity(0.5)) 
    .velocity(0.85)
    .midichan(2).midi(),

  // ==========================================
  // TRACK 4: ACID PLUCK (Rust Ch 2 = Strudel Ch 3)
  // ==========================================
  note("c3 eb3 g3 f3")
    .fast(2)
    .ply("<1 2 3>") 
    .jux(n => n.add(7).rev()) 
    .velocity(saw.range(0.4, 0.9).fast(4)) 
    .mask("<1 1 1 0>")
    .midichan(3).midi()

// ==========================================
// TEMPO
// ==========================================
).cpm(300/4)
