const kick = note("<[36 36*2 36 36] [36 36 36*2 36]>").midichan(10).midi()

const lead = note("< <[a4 ~ c5 d5] [e5 ~ g5 ~] [a5 g5 e5 d5] [c5 d5 e5 ~]>!8 <[c5 ~ e5 f5] [g5 ~ a5 ~] [c6 b5 g5 f5] [e5 f5 g5 ~]>!8 >")
    .fast(2)
    .midichan(1).midi()

const base = note("a2")
    .struct("<[x [~ x] x]*4>")
    // Section A (8 bars): Drops down (A -> G -> F -> E) repeating 4 times
    // Section B (8 bars): Climbs up (F -> G -> A -> C) repeating 4 times
    .add(note("< <0 -2 -4 -5>!8 <-4 -2 0 3>!8 >"))
    .midichan(2).midi()

const acid = note("< <[a3 c4 e4 a4] [g3 b3 d4 g4] [f3 a3 c4 f4] [e3 gs3 b3 e4]>!8 <[f3 a3 c4 f4] [e3 gs3 b3 e4] [d3 f3 a3 d4] [c3 e3 g3 c4]>!8 >")
    .fast(4)
    .midichan(3).midi()


stack(kick, lead, base, acid.slow(4)).cpm(155/4)


