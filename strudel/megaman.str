stack(
  // ==========================================
  // DRUM MACHINE (Channel 10 / Rust Ch 9)
  // ==========================================
  stack(
    // Kick (36) - Driving rock syncopation
    n("<[36 36 ~ 36] [36 ~ 36 36]>*2"),
    
    // Snare (38) - Solid backbeat on 2 and 4
    n("[~ 38]*2"),
    
    // Hi-hat (42) - Frantic 16th notes
    n("42*8"),
    
    // Toms (50, 47, 43) - Descending drum fill every 4th bar
    n("<~ ~ ~ [~ 50 47 43]>"),

    // Modulate the Kick Decay (CC 16) for a breathing low-end feel
    ccv(sine.range(0.25, 0.9).slow(8)).ccn(16)
  ).midichan(10).midi(),

  // ==========================================
  // BASS LINE (Channel 2 / Rust Ch 1)
  // ==========================================
  // i - VI - III - VII progression in C minor
  // 36=C2, 32=Ab1, 39=Eb2, 34=Bb1
  stack(
    // Base rhythm extracted via .struct(), with algorithmic octave leaps
    // Using pure MIDI numbers means .add() does native integer math safely!
    n("<36 32 39 34>")
      .struct("[x x x ~ x x ~ x]*2")
      .add("<0 [0 12] 0 [0 12 0 12]>"),
      
    // Fast LFO sweeping the Filter Cutoff (CC 74) for acid grit
    ccv(saw.range(0.3, 0.9).fast(4)).ccn(74),
    
    // Static Sub Mix (CC 14) cranked up to anchor the track
    ccv(0.8).ccn(14),
    
    // Slight Amp Decay (CC 15) tweak for plucky transient
    ccv(0.4).ccn(15)
  ).midichan(2).midi(),

  // ==========================================
  // ACID PLUCK (Channel 3 / Rust Ch 2)
  // ==========================================
  // Fast 16-bit style counter-melody backing the lead
  stack(
    // Explicitly patterned 16th-note arpeggios translated to pure MIDI numbers
    n("<[60 63 67 63] [56 60 63 60] [63 67 70 67] [58 62 65 62]>")
      .fast(2),
      
    // Slower, evolving sine LFO on the Filter Cutoff (CC 74)
    ccv(sine.range(0.2, 0.8).slow(4)).ccn(74)
  ).midichan(3).midi(),

  // ==========================================
  // SYNTH LEAD (Channel 1 / Rust Ch 0)
  // ==========================================
  // Heroic, soaring melody utilizing rhythmic extraction
  stack(
    // Base melodic contour in raw MIDI integers
    n("< <72 75 79> <77 74 70> <75 72 67> <74 70 65> >")
      .add("<0 12>") // Alternating registers for a wider scope (integer math)
      // Complex rhythmic extraction carved out of the sustained notes
      .struct("<[x ~ ~ x ~ x x ~] [x x ~ x ~ ~ x x]>*2"),
      
    // Synthesizer ADSR shaping
    ccv(0.1).ccn(20), // Fast Attack (CC 20)
    ccv(0.5).ccn(21), // Medium Release (CC 21)
    
    // Delay Effects Chain for retro echoing
    ccv(0.6).ccn(86), // Delay Mix (CC 86)
    ccv(0.5).ccn(85), // Delay Feedback (CC 85)
    
    // Modulating Vibrato Depth (CC 91) and Rate (CC 90) for chiptune wobble
    ccv(sine.range(0.2, 0.8).fast(8)).ccn(91),
    ccv(0.7).ccn(90)
  ).midichan(1).midi()

).cpm(165/4) // High energy tempo set at the global stack level
