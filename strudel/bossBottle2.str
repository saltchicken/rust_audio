stack(
  // ---------------------------------------------------------
  // DRUM MACHINE (Rust Ch 9 = Strudel Ch 10)
  // ---------------------------------------------------------
  stack(
    // Kick: Remains constant to anchor the rhythm
    note("<[36 36*2 36 36] [36 36 36*2 36]>"),
    
    // Snare: Remains constant
    note("<~ 38 ~ 38> <~ 38 ~ [38*3]>"), 
    
    // Hats [EVOLVING]: 
    // Section A (8 bars): Tight, fast 16th notes (42)
    // Section B (8 bars): Opens up to a splashing off-beat ride/open hat feel (46)
    note("< [[42*4]*4]!8 [[~ 46]*4]!8 >"), 
    
    // Toms: Epic descending tom fill dropping in every 4th bar
    note("<~!3 [50*2 47*2 43*2 43*2]>")
  ).midichan(10).midi(),

  // ---------------------------------------------------------
  // SYNTH LEAD MELODY (Rust Ch 0 = Strudel Ch 1)
  // ---------------------------------------------------------
  // Section A (8 bars): The original brooding heroic melody
  // Section B (8 bars): Shifts up the scale, becoming more hopeful and intense
  note("< <[a4 ~ c5 d5] [e5 ~ g5 ~] [a5 g5 e5 d5] [c5 d5 e5 ~]>!8 <[c5 ~ e5 f5] [g5 ~ a5 ~] [c6 b5 g5 f5] [e5 f5 g5 ~]>!8 >")
    .fast(2)
    .midichan(1).midi(),

  // ---------------------------------------------------------
  // BASS LINE (Rust Ch 1 = Strudel Ch 2)
  // ---------------------------------------------------------
  note("a2")
    .struct("<[x [~ x] x]*4>")
    // Section A (8 bars): Drops down (A -> G -> F -> E) repeating 4 times
    // Section B (8 bars): Climbs up (F -> G -> A -> C) repeating 4 times
    .add(note("< <0 -2 -4 -5>!8 <-4 -2 0 3>!8 >"))
    .midichan(2).midi(),

  // ---------------------------------------------------------
  // ACID PLUCK / ARPEGGIO (Rust Ch 2 = Strudel Ch 3)
  // ---------------------------------------------------------
  // The chords follow the Bass Line's exact 8-bar split
  note("< <[a3 c4 e4 a4] [g3 b3 d4 g4] [f3 a3 c4 f4] [e3 gs3 b3 e4]>!8 <[f3 a3 c4 f4] [e3 gs3 b3 e4] [d3 f3 a3 d4] [c3 e3 g3 c4]>!8 >")
    .fast(4)
    .midichan(3).midi()

// ---------------------------------------------------------
// TEMPO
// ---------------------------------------------------------
).cpm(155/4)
