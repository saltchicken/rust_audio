stack(
  // ---------------------------------------------------------
  // DRUM MACHINE (Rust Ch 9 = Strudel Ch 10)
  // Fast, intense battle rhythm 
  // 36: Kick, 38: Snare, 42: Hi-hat, 43/47/50: Toms
  // ---------------------------------------------------------
  stack(
    // Kick: Driving pattern with 16th-note double kicks for urgency
    note("<[36 36*2 36 36] [36 36 36*2 36]>"),
    
    // Snare: Hard hitting on 2 and 4, with a syncopated snare roll at the end of the phrase
    note("<~ 38 ~ 38> <~ 38 ~ [38*3]>"), 
    
    // Hats: Relentless fast 16th notes
    note("[42*4]*4"), 
    
    // Toms: Epic descending tom fill dropping in every 4th bar
    note("<~!3 [50*2 47*2 43*2 43*2]>")
  ).midichan(10).midi(),

  // ---------------------------------------------------------
  // SYNTH LEAD MELODY (Rust Ch 0 = Strudel Ch 1)
  // Heroic, fast-paced brass/synth melody
  // ---------------------------------------------------------
  note("<[a4 ~ c5 d5] [e5 ~ g5 ~] [a5 g5 e5 d5] [c5 d5 e5 ~]>")
    .fast(2)
    .midichan(1).midi(),

  // ---------------------------------------------------------
  // BASS LINE (Rust Ch 1 = Strudel Ch 2)
  // Galloping "Iron Maiden" style 16th-note bass line
  // ---------------------------------------------------------
  note("a2")
    // Creates that classic heavy metal/RPG battle gallop (8th, 16th, 16th)
    .struct("<[x [~ x] x]*4>")
    // Shifting the root note over 4 bars (A -> G -> F -> E)
    .add(note("<0 -2 -4 -5>/4"))
    .midichan(2).midi(),

  // ---------------------------------------------------------
  // ACID PLUCK / ARPEGGIO (Rust Ch 2 = Strudel Ch 3)
  // Frantic sweeping arpeggios to build tension
  // ---------------------------------------------------------
  note("<[a3 c4 e4 a4] [g3 b3 d4 g4] [f3 a3 c4 f4] [e3 gs3 b3 e4]>")
    .fast(4) // Runs the 4 notes above 4 times per bar (16th notes)
    .midichan(3).midi()

// ---------------------------------------------------------
// TEMPO: Very fast and urgent for a boss battle
// ---------------------------------------------------------
).cpm(155/4)
