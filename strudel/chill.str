const setBpm = (bpm) => setcpm(bpm / 4);
setBpm(64);

const drums = (pat) => pat.midichan(10).midi();
const lead = (pat) => pat.midichan(1).midi();
const bass = (pat) => pat.midichan(2).midi();
const acid = (pat) => pat.midichan(3).midi();

const p_lead = lead(
  note("<[e4 ~ g4 b4] [c5 ~ b4 g4] [a4 ~ c5 e5] [b4 ~ g4 e4]>")
    .ccn(20).ccv(0.95) // Attack MS
    .ccn(21).ccv(0.9)  // Release MS
    .ccn(7).ccv(0.75)  // Volume
);

const p_bass = bass(
  note("<e2 ~ c2 ~ a1 ~ b1 ~>")
    .ccn(14).ccv(0.5)  // Sub Mix
    .ccn(15).ccv(0.9)  // Amp Decay
    .ccn(74).ccv(0.3)  // Filter Cutoff Hz
);

const p_acid = acid(
  note("<[e3 g3 b3 d4] [c3 e3 g3 b3] [a3 c4 e4 g4] [b3 d4 f#4 a4]>")
    .ccn(74).ccv(saw.range(0.1, 0.7).slow(32)) // 32-cycle filter sweep
    .ccn(71).ccv(0.4) // Filter Env Mod
);

const p_drums = drums(
  note("<[36 ~ ~ 42] [~ 38 ~ 42] [36 ~ 42 42] [~ 38 ~ 42]>")
    .ccn(16).ccv(0.8)  // Kick Decay
    .ccn(17).ccv(0.5)  // Snare Decay
    .ccn(18).ccv(0.24) // Hi-hat Decay
);

stack(
  p_drums,
  p_lead,
  p_bass,
  p_acid
)
